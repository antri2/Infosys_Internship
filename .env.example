MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your_mysql_password
MYSQL_DATABASE=career_ai

SECRET_KEY=change_this_to_a_long_random_string

# Local LLM model. Qwen is the intended long-term choice.
# Groq can be used for testing with a valid Groq model.
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL_NAME=openai/gpt-oss-20b

# --- Adzuna live job source (OPTIONAL) -----------------------------------
# Get a free key at developer.adzuna.com. Leave these empty to keep using the
# bundled 185-job dataset; the app falls back to it automatically whenever
# Adzuna is unconfigured, unreachable, slow, or returns nothing usable.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# Adzuna country code. "in" is India.
ADZUNA_COUNTRY_CODE=in
# Set to false to keep the credentials but ignore Adzuna entirely.
ADZUNA_ENABLED=true
ADZUNA_TIMEOUT_SECONDS=5
ADZUNA_MAX_RESULTS=50
# Default search location and the query used when a user opens Opportunities
# without searching. Personalization still prefers their profile skills.
ADZUNA_DEFAULT_LOCATION=India
ADZUNA_DEFAULT_QUERY=entry level technology jobs
ADZUNA_JOB_CACHE_TTL_SECONDS=900
ADZUNA_JOB_CACHE_MAX_ENTRIES=500